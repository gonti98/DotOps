#!/usr/bin/env bash
set -euo pipefail

id="{{ .chezmoi.osRelease.id }}"

{{- $systemPackages := list }}
{{- range $category := .categories }}
{{- $systemPackages = concat $systemPackages $category }}
{{- end }}

packages=(
  {{- range ($systemPackages | uniq) }}
  "{{ . }}"
  {{- end }}
)

flatpak_packages=(
  {{- range (.flatpak_packages | default (list) | uniq) }}
  "{{ . }}"
  {{- end }}
)

install_packages() {
  if ((${#packages[@]} == 0)); then
    return 0
  fi

  printf '\n--- Installing packages ---\n'
  sudo pacman --sync --needed --noconfirm -- "${packages[@]}"
}

install_flatpaks() {
  if ((${#flatpak_packages[@]} == 0)); then
    return 0
  fi

  printf '\n--- Installing Flatpaks ---\n'
  flatpak install --assumeyes flathub "${flatpak_packages[@]}"
}

case "$id" in
  arch)
    printf '%s\n' '--- Detected Arch ---'
    install_packages
    install_flatpaks
    ;;
  *)
    printf 'Linux distribution %s is not supported\n' "$id" >&2
    exit 1
    ;;
esac
